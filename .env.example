# GHL Workflow IDs (optional — forms work without these, automation just won't fire)
GHL_EOI_WORKFLOW_ID=              # EOI Gathering confirmation + reminder
GHL_LOCALS_DAY_WORKFLOW_ID=       # Locals Day confirmation + reminder
GHL_WORKSHOP_WORKFLOW_ID=         # Workshop booking confirmation
GHL_QUIZ_WORKFLOW_ID=             # Visitor quiz follow-up
GHL_BUSINESS_REG_WORKFLOW_ID=     # Business registration welcome
GHL_EVENT_SUBMIT_WORKFLOW_ID=     # Event submission acknowledgement
GHL_NEWSLETTER_WORKFLOW_ID=       # Newsletter welcome sequence
GHL_MEMBER_WELCOME_WORKFLOW_ID=   # Harvest member welcome sequence, falls back to newsletter workflow
GHL_MEMBER_QUESTION_WORKFLOW_ID=  # Member question acknowledgement and internal follow-up
GHL_HARVEST_INBOX_PIPELINE_ID=    # Optional override. Defaults to Universal Inquiry
GHL_HARVEST_INBOX_NEW_STAGE_ID=   # Optional override. Defaults to Universal Inquiry / New Inquiry
GHL_GATHERING_RSVP_WORKFLOW_ID=   # Reserved. Leave unset until the public RSVP form is reopened
GHL_SHOP_INTEREST_WORKFLOW_ID=    # Shop expression-of-interest follow-up, falls back to contact form workflow
GHL_PULSE_WORKFLOW_ID=            # Pulse survey follow-up
GHL_CONTACT_FORM_WORKFLOW_ID=     # Contact form auto-reply
GHL_COMMUNITY_SUBMIT_WORKFLOW_ID= # Community submission follow-up
